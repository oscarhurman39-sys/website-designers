# Copy this file to `.env` and fill in real values. NEVER commit the real `.env` file.

# --- GitHub (repo scope) — used to create/transfer private preview-site repos ---
GITHUB_TOKEN=

# --- Vercel — used to deploy website previews ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Email (IMAP + SMTP) — use a dedicated SECONDARY domain, never your primary domain ---
# Use an App Password, not your normal account password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# --- Hugging Face Inference API — used for email drafting ---
HF_API_TOKEN=

# --- Stripe — used for payment collection on won deals ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Slack (optional) — human-in-the-loop alerts ---
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=

# --- Compliance / operator info ---
ADMIN_EMAIL=
SENDING_DOMAIN=
PHYSICAL_ADDRESS=

# --- Optional ---
# Unsplash access key for template hero images. If blank, a placeholder image service is used.
UNSPLASH_ACCESS_KEY=
# Secret used to sign unsubscribe / click-tracking tokens. If blank, one is generated at
# startup and persisted to .secret_key (gitignored) so links stay valid across restarts.
SECRET_KEY=
# Path to the SQLite database file. Leave blank to default to pipeline/leads.db.
DB_PATH=
# Base public URL of webhook_server.py, used to build unsubscribe & tracking links.
PUBLIC_BASE_URL=http://localhost:5000
# Fixed price (in whole USD) charged for a finished website, used by the Stripe checkout flow.
WEBSITE_PRICE_USD=750
# Discounted price quoted for the pre-built draft in cold emails (see sales_agent.py).
WEBSITE_OFFER_PRICE=750

# --- VoltAgent observability (optional) ---
# If both are set, agent/tool spans are also mirrored to VoltAgent Cloud.
# Local trace history in pipeline/traces.json is always written regardless
# (the VoltAgent SDK has no read-back API, so it can't be the dashboard's
# only source of trace data).
VOLTAGENT_PUBLIC_KEY=
VOLTAGENT_SECRET_KEY=
VOLTAGENT_BASE_URL=https://api.voltagent.dev
# Path to the local hierarchical trace log. Leave blank to default to pipeline/traces.json.
TRACES_PATH=

# --- Lead sourcing via Google Places API (New) (optional) ---
# Auto-discovers leads: businesses that are open AND already have a website (so LeadAgent
# can find an email) for every niche x location below. Enable "Places API (New)" on the key
# in Google Cloud -- the legacy Places API will not work. Run `python run.py source --dry-run`
# to see what it would add without writing anything.
GOOGLE_PLACES_API_KEY=
# Off by default: sourcing grows the lead list (and so outbound email volume) on its own.
# When true, main.py sources leads once an hour.
SOURCING_ENABLED=false
# Comma-separated; each must match a folder under templates/ (cafe, dentist, electrician, ...).
SOURCING_NICHES=plumber,electrician,landscaper,cafe,salon,dentist,gym,restaurant
# SEMICOLON-separated (entries contain commas). Each becomes a search like "plumber in Oxted, Surrey".
SOURCING_LOCATIONS=Oxted, Surrey; Caterham, Surrey; Reigate, Surrey; Croydon, London; Bromley, London
# Max leads sourcing may insert per UTC day (counted from the DB, so restarts cannot exceed it).
SOURCING_DAILY_LIMIT=30
# Skip businesses with no website on Google (the pipeline cannot find an email for them anyway).
SOURCING_REQUIRE_WEBSITE=true
