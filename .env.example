# Copy this file to `.env` and fill in real values. NEVER commit the real `.env` file.

# --- GitHub — private preview repos, and the post-payment handover ---
# Personal access token (CLASSIC) with BOTH scopes:
#   repo         create each lead's private repo, push the site, and invite the
#                buyer as an admin collaborator once they pay (that is the handover)
#   delete_repo  delete the repo when a preview expires, and for cleanup-tests.
#                Missing it makes those deletes fail with a 403 worded
#                "Must have admin rights to Repository" even on your own repos.
# Both boxes pre-ticked:
#   https://github.com/settings/tokens/new?scopes=repo,delete_repo
GITHUB_TOKEN=

# --- Vercel — used to deploy website previews ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Optional: sent as the x-vercel-protection-bypass header by screenshot.py as a
# secondary defense against Vercel's deployment-protection login wall, on top
# of vercel_api.py disabling protection outright after each deploy.
VERCEL_BYPASS_TOKEN=

# --- Email (IMAP + SMTP) — use a dedicated SECONDARY domain, never your primary domain ---
# Use an App Password, not your normal account password.
# Zoho Mail: EMAIL_HOST=smtp.zoho.com, EMAIL_IMAP_HOST=imap.zoho.com (.eu for EU accounts)
# Google Workspace: EMAIL_HOST=smtp.gmail.com, EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_HOST=
EMAIL_PORT=587
# IMAP host for reading replies. Blank = same as EMAIL_HOST.
EMAIL_IMAP_HOST=
EMAIL_USER=
EMAIL_PASSWORD=

# --- Extra sending mailboxes (optional) ---
# One mailbox is good for ~25 cold emails/day before deliverability slides, so volume
# comes from several mailboxes, ideally on several domains. EMAIL_USER above is ALWAYS
# mailbox 0; list the extras here, ';'-separated, each in one of two forms:
#   user:password                        SMTP/IMAP hosts inherited from EMAIL_HOST/EMAIL_IMAP_HOST
#   user:password:smtp_host:imap_host    per-mailbox hosts (leave one blank to inherit it)
# A password may contain ':' ONLY in the 4-field form -- the two hosts are split off from
# the right, so everything between the user and them is the password. EMAIL_PORT and
# SENDER_NAME are shared by every mailbox. New leads go to the least-used mailbox under
# EMAIL_MAX_PER_DAY_PER_ACCOUNT; every later email to a lead leaves from the mailbox that
# first emailed them, so a thread never changes From address. Replies are polled from all.
# Example:
#   EMAIL_ACCOUNTS=casey@domain-two.com:app-pw;casey@domain-three.com:app-pw:smtp.zoho.eu:imap.zoho.eu
EMAIL_ACCOUNTS=
# Daily caps. EMAIL_MAX_PER_DAY is the global total across every mailbox (default 50);
# EMAIL_MAX_PER_DAY_PER_ACCOUNT caps each mailbox (default = EMAIL_MAX_PER_DAY). With three
# mailboxes at ~25/day each: EMAIL_MAX_PER_DAY=75, EMAIL_MAX_PER_DAY_PER_ACCOUNT=25.
EMAIL_MAX_PER_DAY=
EMAIL_MAX_PER_DAY_PER_ACCOUNT=

# --- Hugging Face Inference API — used for email drafting ---
HF_API_TOKEN=

# --- Stripe — used for payment collection on won deals ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SendGrid (optional; ON THE BACK BURNER) ---
# Free tier retired in 2025 and terms prohibit cold outreach, so sending goes over
# SMTP from the Zoho mailbox instead. Leave both blank; if set, SendGrid is used
# instead of SMTP for sending. Kept for a possible future transactional use.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Slack (optional) — human-in-the-loop alerts ---
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=

# --- Compliance / operator info ---
ADMIN_EMAIL=
# First name shown in the From header and used as the sign-off. Default: Casey
SENDER_NAME=Casey
SENDING_DOMAIN=
PHYSICAL_ADDRESS=

# --- Optional ---
# Unsplash access key for template hero images. If blank, a placeholder image service is used.
# modern (default) = templates/modern photo-led design for every niche; legacy = old per-niche folders.
DESIGN_TEMPLATE_STYLE=modern
UNSPLASH_ACCESS_KEY=
# Secret used to sign unsubscribe / click-tracking tokens. If blank, one is generated at
# startup and persisted to .secret_key (gitignored) so links stay valid across restarts.
SECRET_KEY=
# Path to the SQLite database file. Leave blank to default to pipeline/leads.db.
DB_PATH=
# Base public URL of webhook_server.py, used to build unsubscribe & tracking links.
PUBLIC_BASE_URL=http://localhost:5000
# Currency for EVERY price: the figures in the email copy and the Stripe charge both
# derive from this, so they can never disagree. Supported: gbp, usd, eur, aud, cad, nzd
# (two-decimal only -- the Stripe amount is price * 100, so JPY would charge 100x and is
# rejected at startup). Blank = gbp.
CURRENCY=gbp
# Fixed price (whole units of CURRENCY) charged for a finished website via Stripe checkout.
WEBSITE_PRICE=589
# Discounted price quoted for the pre-built draft in cold emails (see sales_agent.py).
WEBSITE_OFFER_PRICE=589
# The higher "standard package" figure the cold email anchors against. Default 2000.
STANDARD_PACKAGE_PRICE=2000
# Autonomous negotiation band (whole units of CURRENCY). The LLM sales agent may
# counter/close at any price inside [floor, ceiling]; both are enforced in code (clamped
# before any email or Stripe session), not just in the prompt. Blank = ceiling defaults to
# the offer price, floor defaults to 80% of the ceiling.
# The legacy NEGOTIATION_FLOOR_USD / NEGOTIATION_CEILING_USD / WEBSITE_PRICE_USD spellings
# are still read as a fallback, so an older .env keeps working.
NEGOTIATION_FLOOR=
NEGOTIATION_CEILING=
# Max autonomous negotiation replies per lead before the agent stops and alerts a human
# (also the guard against two autoresponders looping). Default 6.
MAX_NEGOTIATION_ROUNDS=
# Secondary offer quoted beside the one-off price. A prospect who picks it is handed to a human
# (Stripe subscriptions aren't automated yet). Set SUBSCRIPTION_ENABLED=false to hide it.
SUBSCRIPTION_ENABLED=true
SUBSCRIPTION_MONTHLY_PRICE=39
# Trust builders stated in every email.
GUARANTEE_DAYS=14
FREE_EDITS_DAYS=30
# One reminder to leads who never replied, this many days after the cold email.
FOLLOW_UP_ENABLED=true
FOLLOW_UP_AFTER_DAYS=3
# Never cold-email two businesses in the same niche AND town within this many
# days -- otherwise two plumbers in one town get the same template days apart
# and the outreach reads as a mailshot. Small default on purpose: this is a
# hard divisor on send volume (roughly niches x towns / N per day). 0 disables.
OUTREACH_COOLDOWN_DAYS=1
# Safety valve: must be explicitly set to true before the pipeline sends any real
# email. When false/unset, send_email()/send_email_sendgrid() log the drafted
# subject+body to pipeline/dry_run.log instead of sending.
ENABLE_LIVE_SEND=false
# Wrap the emailed preview link in a PUBLIC_BASE_URL/click redirect so clicks
# are recorded. Leave false until PUBLIC_BASE_URL is a real domain, not ngrok.
CLICK_TRACKING_ENABLED=false
# Where daily leads.db backups go (default pipeline/backups/, newest 7 kept).
DB_BACKUP_DIR=

# --- VoltAgent observability (optional) ---
# If both are set, agent/tool spans are also mirrored to VoltAgent Cloud.
# Local trace history in pipeline/traces.json is always written regardless
# (the VoltAgent SDK has no read-back API, so it can't be the dashboard's
# only source of trace data).
VOLTAGENT_PUBLIC_KEY=
VOLTAGENT_SECRET_KEY=
VOLTAGENT_BASE_URL=https://api.voltagent.dev
# Path to the local hierarchical trace log. Leave blank to default to pipeline/traces.json.
TRACES_PATH=

# --- Preview expiry ---
# Cold emails promise the preview is "live for 7 days". Previews of leads that never
# turned into a conversation (status emailed/lost/bounced/unsubscribed) have their
# Vercel project + GitHub repo deleted once they're older than this many days.
PREVIEW_TTL_DAYS=7
# Set to false to disable the hourly teardown pass inside main.py's loop. The one-shot
# `python pipeline/utils/teardown.py [--dry-run]` CLI runs regardless of this flag.
PREVIEW_TEARDOWN_ENABLED=true

# --- Lead sourcing via Google Places API (New) (optional) ---
# Auto-discovers leads: businesses that are open AND already have a website (so LeadAgent
# can find an email) for every niche x location below. Enable "Places API (New)" on the key
# in Google Cloud -- the legacy Places API will not work. Run `python run.py source --dry-run`
# to see what it would add without writing anything.
GOOGLE_PLACES_API_KEY=
# Off by default: sourcing grows the lead list (and so outbound email volume) on its own.
# When true, main.py sources leads once an hour.
SOURCING_ENABLED=false
# Comma-separated; each must match a folder under templates/ (cafe, dentist, electrician, ...).
SOURCING_NICHES=plumber,electrician,landscaper,cafe,salon,dentist,gym,restaurant
# SEMICOLON-separated (entries contain commas). Each becomes a search like "plumber in Oxted, Surrey".
SOURCING_LOCATIONS=Maidstone, Kent; Ashford, Kent; Canterbury, Kent; Tonbridge, Kent; Tunbridge Wells, Kent; Sevenoaks, Kent; Dartford, Kent; Gravesend, Kent; Folkestone, Kent; Dover, Kent; Margate, Kent; Whitstable, Kent; Sittingbourne, Kent; Faversham, Kent; Brighton, East Sussex; Eastbourne, East Sussex; Hastings, East Sussex; Lewes, East Sussex; Uckfield, East Sussex; Crawley, West Sussex; Horsham, West Sussex; Worthing, West Sussex; Haywards Heath, West Sussex; Burgess Hill, West Sussex; Chichester, West Sussex; Bognor Regis, West Sussex
# Max leads sourcing may insert per UTC day (counted from the DB, so restarts cannot exceed it).
SOURCING_DAILY_LIMIT=30
# Skip businesses with no website on Google (the pipeline cannot find an email for them anyway).
SOURCING_REQUIRE_WEBSITE=true
# Skip businesses within this radius (miles) of the lat,lng below. Default centre = Oxted.
SOURCING_EXCLUDE_CENTER=51.2572,0.0040
SOURCING_EXCLUDE_RADIUS_MILES=6
