# Copy this file to `.env` and fill in real values. NEVER commit the real `.env` file.

# --- GitHub (repo scope) — used to create/transfer private preview-site repos ---
GITHUB_TOKEN=

# --- Vercel — used to deploy website previews ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Email (IMAP + SMTP) — use a dedicated SECONDARY domain, never your primary domain ---
# Use an App Password, not your normal account password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# --- Hugging Face Inference API — used for email drafting ---
HF_API_TOKEN=

# --- Stripe — used for payment collection on won deals ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Slack (optional) — human-in-the-loop alerts ---
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=

# --- SendGrid (optional) — alternative email transport ---
# If SENDGRID_API_KEY is set, all outbound email goes through SendGrid's API
# instead of SMTP (SENDGRID_FROM_EMAIL must then also be set, and should be a
# verified sender on your SendGrid account). Leave blank to send via SMTP.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Compliance / operator info ---
ADMIN_EMAIL=
SENDING_DOMAIN=
PHYSICAL_ADDRESS=

# --- Optional ---
# Unsplash access key for template hero images. If blank, a placeholder image service is used.
UNSPLASH_ACCESS_KEY=
# Secret used to sign unsubscribe / click-tracking tokens. If blank, one is generated at
# startup and persisted to .secret_key (gitignored) so links stay valid across restarts.
SECRET_KEY=
# Path to the SQLite database file. Leave blank to default to pipeline/leads.db.
DB_PATH=
# Base public URL of webhook_server.py, used to build unsubscribe & tracking links.
PUBLIC_BASE_URL=http://localhost:5000
# Currency for BOTH the prices quoted in cold emails and the Stripe charge —
# one setting so a lead is never quoted one currency and charged another.
# Lowercase ISO code (gbp, usd, eur). Defaults to gbp, matching the email copy.
PAYMENT_CURRENCY=gbp
# Fixed price (whole units of PAYMENT_CURRENCY) charged for a finished website
# via Stripe checkout. (WEBSITE_PRICE_USD still works as a legacy alias.)
WEBSITE_PRICE=750
# Discounted price quoted for the pre-built draft in cold emails (see sales_agent.py).
WEBSITE_OFFER_PRICE=750
# Non-discounted "standard package" price named in the same offer copy.
WEBSITE_ANCHOR_PRICE=2000

# --- VoltAgent observability (optional) ---
# If both are set, agent/tool spans are also mirrored to VoltAgent Cloud.
# Local trace history in pipeline/traces.json is always written regardless
# (the VoltAgent SDK has no read-back API, so it can't be the dashboard's
# only source of trace data).
VOLTAGENT_PUBLIC_KEY=
VOLTAGENT_SECRET_KEY=
VOLTAGENT_BASE_URL=https://api.voltagent.dev
# Path to the local hierarchical trace log. Leave blank to default to pipeline/traces.json.
TRACES_PATH=
