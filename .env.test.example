# Copy this file to `.env.test` (repo root) and fill in REAL, test-safe
# credentials before running:
#
#   pip install -r pipeline/requirements.txt
#   pytest --run-real tests/test_pipeline_real.py -v -s
#
# NEVER commit the real `.env.test` -- it holds live credentials just like
# `.env` does (it's gitignored). tests/test_pipeline_real.py hits real
# GitHub/Vercel/SMTP/IMAP APIs and deletes what it creates when it's done,
# but review every value below before running -- a wrong DB_PATH, for
# example, could point the test at your real leads.db.
#
# If this file doesn't exist, tests/conftest.py falls back to your real
# `.env` instead of skipping -- but it always forces DB_PATH/TRACES_PATH
# to throwaway pipeline/leads.test.db / traces.test.json regardless of
# what `.env` says, so a fallback run still can't touch production data.
# Still: create this file if you want explicit control over which
# credentials the test uses, rather than relying on that fallback.

GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
HF_API_TOKEN=
# Only needed if you set MOCK_SCRAPING=false below (real LeadAgent path).
GOOGLE_PLACES_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADMIN_EMAIL=
SENDING_DOMAIN=
PHYSICAL_ADDRESS=123 Test St, Testville, USA

# Throwaway DB/trace files so the test never touches your real leads.db /
# traces.json. These are relative to wherever you invoke `pytest` from --
# run it from the repo root (as in the command above) and the `pipeline/`
# prefix below lands them next to the real (untouched) leads.db/traces.json
# for easy comparison; if you invoke pytest from elsewhere, use absolute
# paths instead.
DB_PATH=pipeline/leads.test.db
TRACES_PATH=pipeline/traces.test.json

PUBLIC_BASE_URL=http://localhost:5000
WEBSITE_PRICE_USD=1

# If true, the test skips LeadAgent's real Google Places lookup + website
# email-scrape and enriches the fake test lead with fixed data instead --
# keeps the test fast and deterministic, and avoids needing a
# GOOGLE_PLACES_API_KEY just to test the rest of the pipeline. Set to
# "false" to also exercise the real Places API call (requires
# GOOGLE_PLACES_API_KEY above) and, if a website is found, a real scrape
# of it for a contact email.
MOCK_SCRAPING=true
